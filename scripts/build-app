#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
CONFIGURATION="${CONFIGURATION:-release}"
mkdir -p build/swift-cache
swift build --configuration "$CONFIGURATION" --scratch-path build/swift --cache-path build/swift-cache
BIN="$(swift build --configuration "$CONFIGURATION" --scratch-path build/swift --cache-path build/swift-cache --show-bin-path)"
APP="$ROOT/build/iPad Screen.app"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN/IPadScreenMac" "$APP/Contents/MacOS/IPadScreenMac"
cp Resources/Info.plist "$APP/Contents/Info.plist"
codesign --force --sign "${CODESIGN_IDENTITY:--}" --identifier me.kerim.ipad-screen.mac "$APP"
codesign --verify --strict "$APP"
printf 'Built %s\n' "$APP"
